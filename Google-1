10. Java coding problem: Library, Authors, and Books

Requirements:
→ TODO #1: Assign books to the correct authors and store them in authorsBooks.
→ TODO #2: Return all books of a particular BookType.
→ TODO #3: Set each author's booksAmount based on the map.

Solution:

import java.util.*;
import java.util.stream.*;

class Library {
    Map<Author, List<Book>> authorsBooks;
    List<Author> authors;

    public Library() {
        authorsBooks = new HashMap<>();
        authors = AuthorDataProvider.getAuthors();
        initialize();
    }

    private void initialize() {
        List<Book> books = List.of(
            new Book(1, "The Way of Kings", BookType.FANTASY),
            new Book(1, "Mistborn", BookType.FANTASY),
            new Book(1, "Elantris", BookType.FANTASY),
            new Book(2, "Thinking, Fast and Slow", BookType.FACT),
            new Book(2, "Noise", BookType.FACT),
            new Book(3, "The Witcher", BookType.FANTASY),
            new Book(4, "A Brief History of Time", BookType.SCIENCE),
            new Book(4, "Brief Answers To The Big Questions", BookType.SCIENCE)
        );

        // TODO #1: Assign books to their authors.
        for (Author author : authors) {
            List<Book> authorBooks = books.stream()
                .filter(book -> book.getAuthorId() == author.getId())
                .collect(Collectors.toList());

            authorsBooks.put(author, authorBooks);
        }

        // TODO #3: Set the number of books for each author.
        for (Author author : authors) {
            author.setBooksAmount(
                authorsBooks.get(author).size()
            );
        }
    }

    // TODO #2: Return books of a particular type.
    public List<Book> getBooksOfType(BookType bookType) {
        return authorsBooks.values().stream()
            .flatMap(Collection::stream)
            .filter(book -> book.getBookType() == bookType)
            .collect(Collectors.toList());
    }

    public List<Book> getBooksByAuthorId(int id) {
        Author author = authors.stream()
            .filter(a -> a.getId() == id)
            .findFirst()
            .orElseThrow();

        return authorsBooks.get(author);
    }

    private int getBooksAmount(int authorId) {
        return authors.stream()
            .filter(a -> a.getId() == authorId)
            .findFirst()
            .orElseThrow()
            .getBooksAmount();
    }
}

